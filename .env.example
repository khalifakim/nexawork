# NexaWork — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs avant de lancer docker-compose

# JWT — secret partagé entre tous les microservices (Base64, min 256 bits)
JWT_SECRET=bmV4YXdvcmtfc2VjcmV0X2NoYW5nZV9pbl9wcm9k

# Jitsi Meet — doivent être identiques dans prosody, web et meeting-service
JITSI_APP_ID=nexawork
JITSI_SECRET=jitsi_secret_change_in_prod
JICOFO_COMPONENT_SECRET=jicofo_secret_change_in_prod
JICOFO_AUTH_PASSWORD=jicofo_password_change_in_prod
JVB_AUTH_PASSWORD=jvb_password_change_in_prod

# Adresse IP publique de la machine hôte (pour jitsi-jvb en production)
DOCKER_HOST_ADDRESS=127.0.0.1

# CORS — origines autorisées pour l'API Gateway
CORS_ORIGINS=http://localhost:4200
